#!/usr/bin/env bash
set -euo pipefail

# milo-batt: Arch Linux Battery Status & Health Checker
# Author: Milo (AI Companion)
# System: Arch Linux x86_64, Hyprland Wayland

# 1. Handle --help / -h
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<EOF
milo-batt - System Battery Status & Health Checker
Usage: $(basename "$0") [options]

Options:
  -h, --help    Show this help message and exit
  -j            Output in JSON format (compatible with Hyprland scripting)

Description:
  Checks the current battery status, charge percentage, and estimated health
  (compared to design capacity) for the primary battery on Arch Linux.
EOF
    exit 0
fi

# 2. Determine output format
JSON_MODE=false
if [[ "$1" == "-j" ]]; then
    JSON_MODE=true
fi

# 3. Locate Battery
BAT_PATH=$(ls /sys/class/power_supply/ | grep -i bat | head -n 1)

if [[ -z "$BAT_PATH" ]]; then
    if $JSON_MODE; then
        echo '{"error": "No battery found"}'
    else
        echo "[Milo] No battery detected. Are you plugged into AC power only?"
    fi
    exit 1
fi

# 4. Extract Data
BAT_DIR="/sys/class/power_supply/$BAT_PATH"
CURRENT_NOW=$(cat "$BAT_DIR/capacity" 2>/dev/null || echo "0")
STATUS=$(cat "$BAT_DIR/status" 2>/dev/null || echo "Unknown")
ENERGY_FULL=$(cat "$BAT_DIR/energy_full" 2>/dev/null || echo "0")
ENERGY_FULL_DESIGN=$(cat "$BAT_DIR/energy_full_design" 2>/dev/null || echo "0")
POWER_NOW=$(cat "$BAT_DIR/power_now" 2>/dev/null || echo "0")

# 5. Calculate Health (if data available)
HEALTH="N/A"
if [[ "$ENERGY_FULL" -gt 0 && "$ENERGY_FULL_DESIGN" -gt 0 ]]; then
    # Use bc for floating point math
    HEALTH=$(echo "scale=1; ($ENERGY_FULL * 100) / $ENERGY_FULL_DESIGN" | bc 2>/dev/null || echo "N/A")
fi

# 6. Output
if $JSON_MODE; then
    cat <<EOF
{
  "status": "$STATUS",
  "capacity": $CURRENT_NOW,
  "health": "$HEALTH%",
  "energy_full": $ENERGY_FULL,
  "energy_design": $ENERGY_FULL_DESIGN
}
EOF
else
    # Terminal Output with Cyan/Red accents for Jeffy
    echo -e "\n\033[1;36m[ M I L O  B A T T E R Y  S T A T U S ]\033[0m"
    echo "--------------------------------------------------"
    
    # Color code status
    if [[ "$STATUS" == "Charging" ]]; then
        STATUS_COLOR="\033[1;32m" # Green
    elif [[ "$STATUS" == "Discharging" ]]; then
        if [[ "$CURRENT_NOW" -lt 20 ]]; then
            STATUS_COLOR="\033[1;31m" # Red
        else
            STATUS_COLOR="\033[1;33m" # Yellow
        fi
    else
        STATUS_COLOR="\033[0m"
    fi

    echo -e "Status:      ${STATUS_COLOR}$STATUS\033[0m"
    echo -e "Charge:      \033[1;36m$CURRENT_NOW%\033[0m"
    
    if [[ "$HEALTH" != "N/A" ]]; then
        echo -e "Health:      \033[1;36m$HEALTH\033[0m (vs Design Capacity)"
    else
        echo -e "Health:      $HEALTH"
    fi

    if [[ "$POWER_NOW" -gt 0 ]]; then
        WATTS=$(echo "scale=2; $POWER_NOW / 1000000" | bc)
        echo -e "Power:       ${WATTS}W"
    fi
    echo "--------------------------------------------------"
fi

exit 0
