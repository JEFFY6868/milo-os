#!/usr/bin/env bash
# ==============================================================================
# Milo Ask — Fast Cognitive Assistant with 6-Encounter Adaptive Memory
# Part of MiloOS. Built for Arch Linux & Hyprland.
# ==============================================================================
set -e

PYTHON_BIN="${HOME}/.local/share/milo/venv/bin/python3"
if [ ! -x "$PYTHON_BIN" ]; then
    PYTHON_BIN="python3"
fi

exec "$PYTHON_BIN" ${HOME}/.local/share/milo/cortex/cortex_cli.py ask "$@"
