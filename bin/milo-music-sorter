def clean_track_name(s: str) -> str:
    """Clean filename by stripping MassTamilan/StarMusiQ domain tags and punctuation."""
    s = re.sub(r'-(?:MassTamilan|StarMusiQ|Isaimini|TamilWire|123Musiq)(?:\.[a-z0-9]+)?', '', s, flags=re.I)
    s = re.sub(r'\.(?:com|org|io|dev|fm|so|net|in)', '', s, flags=re.I)
    s = re.sub(r'\[.*?\]|\(.*?\)', '', s)
    s = re.sub(r'[_\-]+', ' ', s).strip()
    return re.sub(r'\s+', ' ', s).strip()


def parse_id3(path: Path) -> dict:
    """Fast, pure Python ID3v2 tag parser (reads title, artist, album in <2ms)."""
    tags = {}
    try:
        with open(path, 'rb') as f:
            header = f.read(10)
            if header[:3] != b'ID3':
                return tags
            version = header[3]
            size = ((header[6] & 0x7F) << 21) | ((header[7] & 0x7F) << 14) | ((header[8] & 0x7F) << 7) | (header[9] & 0x7F)
            data = f.read(size)
            pos = 0
            while pos < len(data) - 10:
                frame_id = data[pos:pos+4].decode('latin1', errors='ignore')
                if not frame_id.isalnum():
                    break
                frame_size = int.from_bytes(data[pos+4:pos+8], 'big')
                if version == 4:
                    frame_size = ((data[pos+4] & 0x7F) << 21) | ((data[pos+5] & 0x7F) << 14) | ((data[pos+6] & 0x7F) << 7) | (data[pos+7] & 0x7F)
                pos += 10
                if frame_size <= 0 or pos + frame_size > len(data):
                    break
                val_data = data[pos:pos+frame_size]
                pos += frame_size
                if frame_id in ('TIT2', 'TPE1', 'TALB'):
                    encoding = val_data[0] if len(val_data) > 0 else 0
                    raw = val_data[1:]
                    val = ''
                    if encoding == 0:
                        val = raw.decode('latin1', errors='ignore').strip('\x00')
                    elif encoding == 1:
                        val = raw.decode('utf-16', errors='ignore').strip('\x00')
                    elif encoding == 3:
                        val = raw.decode('utf-8', errors='ignore').strip('\x00')
                    tags[frame_id] = val
    except Exception:
        pass
    return tags


def load_overrides() -> dict:
    if OVERRIDES_FILE.exists():
        try:
            return json.loads(OVERRIDES_FILE.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def save_override(filename: str, mood: str):
    overrides = load_overrides()
    overrides[filename] = mood
    OVERRIDES_FILE.parent.mkdir(parents=True, exist_ok=True)
    OVERRIDES_FILE.write_text(json.dumps(overrides, indent=2), encoding="utf-8")


def classify_track(path: Path, overrides: dict = None) -> tuple:
    """
    Classify track into (mood, confidence, title, artist, album).
    Returns mood in ('vibe', 'sad', 'melody', 'motivation').
    """
    if overrides is None:
        overrides = load_overrides()

    fn = path.name
    if fn in overrides:
        return overrides[fn], 1.0, clean_track_name(path.stem), "Unknown", "Unknown"

    stem_clean = clean_track_name(path.stem).lower()
    meta = parse_id3(path)
    title = clean_track_name(meta.get("TIT2", path.stem))
    artist = clean_track_name(meta.get("TPE1", "Unknown Artist"))
    album = clean_track_name(meta.get("TALB", "Unknown Album"))

    # Match primarily on title and filename to avoid album title bleed (e.g. Leo melodies)
    text_to_match = f"{stem_clean} {title.lower()}"
    if any(k in album.lower() for k in ("theme", "bgm", "ost", "score")):
        text_to_match += f" {album.lower()}"

    # 1. Check Sad
    for pat in SAD_PATTERNS:
        if re.search(pat, text_to_match):
            return "sad", 0.95, title, artist, album

    # 2. Check Motivation
    for pat in MOTIVATION_PATTERNS:
        if re.search(pat, text_to_match):
            return "motivation", 0.92, title, artist, album

    # 3. Check Vibe
    for pat in VIBE_PATTERNS:
        if re.search(pat, text_to_match):
            return "vibe", 0.94, title, artist, album

    # 4. Default to Melody (Romantic / Chill / Acoustic)
    return "melody", 0.85, title, artist, album


def scan_and_build(force_rescan: bool = False) -> dict:
    """Scans ~/Music, classifies all tracks, and generates .m3u playlists."""
    PLAYLISTS_DIR.mkdir(parents=True, exist_ok=True)

    exts = ("*.mp3", "*.flac", "*.wav", "*.m4a", "*.ogg")
    tracks = []
    for ext in exts:
        tracks.extend(MUSIC_DIR.rglob(ext))

    tracks = sorted(list(set(tracks)))
    if not tracks:
        print(f"No audio tracks found in {MUSIC_DIR}")
        return {}

    overrides = load_overrides()
    catalog = {
        "vibe": [],
        "sad": [],
        "melody": [],
        "motivation": []
    }
    all_tracks_meta = []

    for t in tracks:
        mood, conf, title, artist, album = classify_track(t, overrides)
        if mood not in catalog:
            mood = "melody"
        catalog[mood].append(t)
        all_tracks_meta.append({
            "path": str(t),
            "filename": t.name,
            "title": title,
            "artist": artist,
            "album": album,
            "mood": mood,
            "confidence": conf
        })

    # Write .m3u playlists
    for mood, t_list in catalog.items():
        m3u_path = PLAYLISTS_DIR / f"{mood}.m3u"
        shuffled = list(t_list)
        random.shuffle(shuffled)
        with open(m3u_path, "w", encoding="utf-8") as f:
            for item in shuffled:
                f.write(str(item) + "\n")

    # Also write all.m3u
    all_m3u = PLAYLISTS_DIR / "all.m3u"
    shuffled_all = list(tracks)
    random.shuffle(shuffled_all)
    with open(all_m3u, "w", encoding="utf-8") as f:
        for item in shuffled_all:
            f.write(str(item) + "\n")

    # Save metadata JSON cache
    cache_payload = {
        "total_tracks": len(tracks),
        "counts": {m: len(catalog[m]) for m in catalog},
        "tracks": all_tracks_meta
    }
    VIBES_CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    VIBES_CACHE_FILE.write_text(json.dumps(cache_payload, indent=2), encoding="utf-8")

    return cache_payload


def print_stats():
    if not VIBES_CACHE_FILE.exists():
        scan_and_build()

    try:
        data = json.loads(VIBES_CACHE_FILE.read_text(encoding="utf-8"))
        counts = data.get("counts", {})
        total = data.get("total_tracks", 0)

        print("\033[1;36m" + "=" * 54 + "\033[0m")
        print("  \033[1;37mMILO PROTOCOL // VIBE & MOOD MATRIX\033[0m")
        print(f"  \033[1;32mTotal Tracks Grounded:\033[0m \033[1;37m{total}\033[0m")
        print("\033[1;36m" + "-" * 54 + "\033[0m")
        for m, label in MOOD_LABELS.items():
            cnt = counts.get(m, 0)
            pct = (cnt / total * 100) if total > 0 else 0
            print(f"  {label:<28} : \033[1;33m{cnt:>4}\033[0m tracks ({pct:>5.1f}%)")
        print("\033[1;36m" + "=" * 54 + "\033[0m")
    except Exception as e:
        print(f"Error reading stats: {e}")


def list_mood(mood: str):
    mood = mood.lower()
    if mood not in MOOD_LABELS:
        print(f"Unknown mood '{mood}'. Choose from: vibe, sad, melody, motivation")
        return

    m3u_path = PLAYLISTS_DIR / f"{mood}.m3u"
    if not m3u_path.exists():
        scan_and_build()

    if m3u_path.exists():
        lines = [line.strip() for line in m3u_path.read_text(encoding="utf-8").splitlines() if line.strip()]
        print(f"\n{MOOD_LABELS[mood]} ({len(lines)} tracks):\n")
        for idx, p in enumerate(lines[:40], 1):
            print(f"  {idx:2d}. {clean_track_name(Path(p).stem)}")
        if len(lines) > 40:
            print(f"  ... and {len(lines) - 40} more tracks.")


def main():
    if len(sys.argv) < 2:
        print_stats()
        return

    arg = sys.argv[1].lower()
    if arg in ("--rescan", "rescan", "sort", "build"):
        print("Scanning ~/Music and classifying soundtrack vibes...")
        res = scan_and_build(force_rescan=True)
        print_stats()
    elif arg in ("--stats", "stats", "summary"):
        print_stats()
    elif arg in ("--list", "list") and len(sys.argv) > 2:
        list_mood(sys.argv[2])
    elif arg in ("--tag", "tag", "set") and len(sys.argv) > 3:
        target = sys.argv[2]
        mood = sys.argv[3].lower()
        if mood in MOOD_LABELS:
            save_override(target, mood)
            print(f"Tagged '{target}' as {MOOD_LABELS[mood]}. Run 'milo-music-sorter rescan' to rebuild playlists.")
        else:
            print(f"Invalid mood: {mood}")
    else:
        print("Usage: milo-music-sorter [--rescan | --stats | --list <mood> | --tag <song> <mood>]")


if __name__ == "__main__":
    main()
