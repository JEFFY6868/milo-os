#!/usr/bin/env python3
"""
milo-music-sorter: Cyber Vibe & Mood Classifier for MiloOS Soundtrack
Part of MiloOS. Built for Arch Linux & Wayland Desktop HUD.

Classifies local audio tracks in ~/Music into 4 primary vibes:
  - ⚡ vibe: High energy, Kuthu, Party, Gaana, Dance, Upbeat
  - 🌧️ sad: Pathos, Heartbreak, Pain, Sorrow, Lullaby, Separation
  - 💖 melody: Romance, Acoustic, Breezy, Soul, Chill, Soft, Nostalgic
  - 🔥 motivation: Climax themes, Workout, Focus, High-energy Mass, Anthem

Generates playlists in ~/.config/milo/playlists/:
  - vibe.m3u
  - sad.m3u
  - melody.m3u
  - motivation.m3u
  - all.m3u
"""

