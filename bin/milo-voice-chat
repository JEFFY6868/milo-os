#!/usr/bin/env python3
"""
Milo Voice AI Assistant (milo-voice-chat)
Fully offline end-to-end voice conversation loop:
Microphone -> Phonon-2 ASR (~164MB) -> Milo Cortex Qwen2.5-0.5B (~350MB) -> Response.

Usage:
    milo-voice-chat          # Interactive push-to-talk voice conversation
"""

import sys
import os
import time
import json
import socket
import tempfile
import subprocess
from pathlib import Path
import numpy as np

PHONON_DIR = Path.home() / ".local/share/milo/phonon"
if str(PHONON_DIR) not in sys.path:
    sys.path.insert(0, str(PHONON_DIR))

import client

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR")
if RUNTIME_DIR and Path(RUNTIME_DIR).exists():
    CORTEX_SOCKET_PATH = Path(RUNTIME_DIR) / "milo-cortex.sock"
else:
    CORTEX_SOCKET_PATH = Path(f"/tmp/milo-cortex-{os.getuid()}.sock")


def notify(summary: str, body: str = "", timeout: int = 2000):
    """Send notification via notify-send."""
    try:
        subprocess.run(
            ["notify-send", "-t", str(timeout), "-a", "Milo Voice AI", summary, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


def record_speech(max_seconds: float = 20.0, silence_timeout: float = 1.5) -> Path:
    """Record microphone audio until silence is detected."""
    import sounddevice as sd
    import soundfile as sf

    sample_rate = 16000
    chunk_duration = 0.1
    chunk_samples = int(sample_rate * chunk_duration)

    recorded_chunks = []
    speech_detected = False
    silence_counter = 0
    silence_threshold_energy = 0.012

    notify("🎙️ Milo Listening...", "Ask your question...", timeout=2000)
    print("🎙️ Listening... (Speak now)")

    start_time = time.time()
    with sd.InputStream(samplerate=sample_rate, channels=1, dtype="float32", blocksize=chunk_samples) as stream:
        while True:
            chunk, _ = stream.read(chunk_samples)
            recorded_chunks.append(chunk)

            rms = np.sqrt(np.mean(chunk**2))
            if rms > silence_threshold_energy:
                speech_detected = True
                silence_counter = 0
            elif speech_detected:
                silence_counter += chunk_duration
                if silence_counter >= silence_timeout:
                    break

            if (time.time() - start_time) >= max_seconds:
                break

    if not recorded_chunks:
        return None

    audio_data = np.concatenate(recorded_chunks, axis=0)
    if len(audio_data) / sample_rate < 0.5 or np.max(np.abs(audio_data)) < 0.005:
        return None

    tmp_wav = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    sf.write(tmp_wav.name, audio_data, sample_rate, subtype="PCM_16")
    return Path(tmp_wav.name)


def query_cortex(prompt: str) -> str:
    """Query resident Milo Cortex daemon."""
    if not CORTEX_SOCKET_PATH.exists():
        return f"[Cortex daemon not found at {CORTEX_SOCKET_PATH}]"

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(30.0)
            s.connect(str(CORTEX_SOCKET_PATH))
            req = {"action": "synthesize", "query": prompt, "max_tokens": 128}
            s.sendall(json.dumps(req).encode("utf-8") + b"\n")

            full_tokens = []
            while True:
                line = s.recv(4096).decode("utf-8")
                if not line:
                    break
                for raw_part in line.strip().split("\n"):
                    if not raw_part:
                        continue
                    try:
                        data = json.loads(raw_part)
                        if "token" in data:
                            token = data["token"]
                            full_tokens.append(token)
                            print(token, end="", flush=True)
                        if data.get("done"):
                            break
                    except Exception:
                        pass
            return "".join(full_tokens)
    except Exception as e:
        return f"[Cortex Error: {e}]"


def main():
    print("=" * 60)
    print("🧠 Milo Offline Voice AI Loop (Phonon-2 + Cortex Qwen)")
    print("=" * 60)

    try:
        while True:
            input("\n[Press Enter to Speak, or Ctrl+C to exit] ")
            wav_path = record_speech()
            if not wav_path:
                print("⚠️ No speech detected.")
                continue

            try:
                print("⚡ Transcribing audio...")
                res = client.request_transcribe_file(wav_path)
                query = res.get("text", "").strip()

                if not query:
                    print("⚠️ Could not transcribe speech.")
                    continue

                print(f"\n👤 You: {query}")
                print("🧠 Milo Cortex: ", end="", flush=True)
                answer = query_cortex(query)
                print("\n")
                notify("🧠 Milo Cortex", answer, timeout=5000)

            finally:
                if wav_path.exists():
                    wav_path.unlink()

    except KeyboardInterrupt:
        print("\n👋 Voice loop exited.")


if __name__ == "__main__":
    main()
