#!/usr/bin/env python3
"""
Milo OS - Tactical Control Center CLI & Native Overlay Trigger
Author: Milo OS Core Team
Target: Arch Linux / Hyprland / Quickshell
"""

import sys
import os
import re
import json
import time
import subprocess
from pathlib import Path

TRIGGER_PATH = Path("/tmp/milo-control-center-trigger")
BAR_OFF_FILE = Path.home() / ".local" / "state" / "omarchy" / "toggles" / "bar-off"


def notify_gui(action: str = "toggle") -> None:
    try:
        TRIGGER_PATH.write_text(f"{int(time.time() * 1000)} {action}\n")
    except Exception:
        pass

    try:
        if action == "toggle":
            subprocess.run(["omarchy-shell", "milo", "toggleControlCenter"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "open":
            subprocess.run(["omarchy-shell", "milo", "openControlCenter"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "open_wifi":
            subprocess.run(["omarchy-shell", "milo", "openWifiScanner"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "open_bt":
            subprocess.run(["omarchy-shell", "milo", "openBtScanner"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "close":
            subprocess.run(["omarchy-shell", "milo", "closeControlCenter"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def get_status() -> dict:
    # 1. Volume & Mute
    vol = 50
    muted = False
    try:
        out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], text=True).strip()
        parts = out.split()
        if len(parts) >= 2:
            vol = int(round(float(parts[1]) * 100))
            muted = "[MUTED]" in out
    except Exception:
        pass

    # 2. Brightness
    bright = 50
    try:
        out = subprocess.check_output(["brightnessctl", "-m"], text=True).strip()
        parts = out.split(",")
        if len(parts) >= 4:
            bright = int(parts[3].replace("%", ""))
    except Exception:
        pass

    # 3. Wi-Fi
    wifi_enabled = True
    wifi_ssid = "Disconnected"
    wifi_ip = "127.0.0.1"
    try:
        out = subprocess.check_output(["nmcli", "-t", "-f", "WIFI", "general"], text=True).strip().lower()
        wifi_enabled = (out == "enabled")
        if wifi_enabled:
            ssid_out = subprocess.check_output(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"], text=True).strip()
            for line in ssid_out.splitlines():
                if line.startswith("yes:"):
                    wifi_ssid = line.split(":", 1)[1]
                    break
            ip_out = subprocess.check_output(["hostname", "-I"], text=True).strip()
            if ip_out:
                wifi_ip = ip_out.split()[0]
    except Exception:
        pass

    # 4. Bluetooth
    bt_enabled = False
    bt_device = "None"
    bt_battery = ""
    try:
        bt_out = subprocess.check_output(["bluetoothctl", "show"], text=True)
        bt_enabled = "Powered: yes" in bt_out
        if bt_enabled:
            dev_out = subprocess.check_output(["bluetoothctl", "devices", "Connected"], text=True).strip()
            if dev_out:
                parts = dev_out.splitlines()[0].split(" ", 2)
                if len(parts) >= 3:
                    bt_device = parts[2]
            else:
                bt_device = "Ready"
    except Exception:
        pass

    # 5. Nightlight
    nightlight_enabled = False
    try:
        temp_out = subprocess.check_output(["hyprctl", "hyprsunset", "temperature"], text=True).strip()
        m = re.search(r"\d+", temp_out)
        if m and int(m.group(0)) < 6000:
            nightlight_enabled = True
    except Exception:
        pass

    # 6. Omarchy Top Bar
    bar_off = BAR_OFF_FILE.exists()

    return {
        "volume": vol,
        "muted": muted,
        "brightness": bright,
        "wifi_enabled": wifi_enabled,
        "wifi_ssid": wifi_ssid,
        "wifi_ip": wifi_ip,
        "bt_enabled": bt_enabled,
        "bt_device": bt_device,
        "bt_battery": bt_battery,
        "nightlight_enabled": nightlight_enabled,
        "bar_off": bar_off,
    }


def scan_wifi() -> list:
    networks = []
    try:
        # Request rescan first
        try:
            subprocess.run(["nmcli", "dev", "wifi", "rescan"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
        except Exception:
            pass

        out = subprocess.check_output(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"], text=True)
        seen = set()
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) >= 3:
                in_use = (parts[0] == "*")
                ssid = parts[1].strip()
                if not ssid or ssid in seen:
                    continue
                seen.add(ssid)
                sig = int(parts[2]) if parts[2].isdigit() else 50
                sec = parts[3].strip() if len(parts) > 3 and parts[3].strip() else "Open"
                networks.append({
                    "ssid": ssid,
                    "signal": sig,
                    "in_use": in_use,
                    "security": sec
                })
    except Exception as e:
        networks.append({"ssid": "Error", "signal": 0, "in_use": False, "security": str(e)})

    # Sort: in_use first, then by signal strength descending
    networks.sort(key=lambda x: (not x.get("in_use", False), -x.get("signal", 0)))
    return networks


def connect_wifi(ssid: str, password: str = None) -> bool:
    try:
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if password:
            cmd.extend(["password", password])
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return (res.returncode == 0)
    except Exception:
        return False


def scan_bt() -> list:
    devices = []
    try:
        out = subprocess.check_output(["bluetoothctl", "devices"], text=True)
        conn_out = subprocess.check_output(["bluetoothctl", "devices", "Connected"], text=True)
        connected_macs = set()
        for line in conn_out.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                connected_macs.add(parts[1])

        for line in out.splitlines():
            parts = line.split(" ", 2)
            if len(parts) >= 3 and parts[0] == "Device":
                mac = parts[1]
                name = parts[2].strip()
                devices.append({
                    "mac": mac,
                    "name": name,
                    "connected": mac in connected_macs
                })
    except Exception:
        pass
    devices.sort(key=lambda x: not x.get("connected", False))
    return devices


def connect_bt(mac: str) -> bool:
    try:
        res = subprocess.run(["bluetoothctl", "connect", mac], capture_output=True, text=True, timeout=10)
        return (res.returncode == 0)
    except Exception:
        return False


def disconnect_bt(mac: str) -> bool:
    try:
        res = subprocess.run(["bluetoothctl", "disconnect", mac], capture_output=True, text=True, timeout=10)
        return (res.returncode == 0)
    except Exception:
        return False


def set_volume(val: int):
    val = max(0, min(150, int(val)))
    frac = round(val / 100.0, 2)
    try:
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(frac)], check=True)
    except Exception:
        pass


def toggle_mute():
    try:
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], check=True)
    except Exception:
        pass


def set_brightness(val: int):
    val = max(10, min(100, int(val)))
    try:
        subprocess.run(["brightnessctl", "set", f"{val}%", "-q"], check=True)
    except Exception:
        pass


def toggle_wifi():
    st = get_status()
    action = "off" if st["wifi_enabled"] else "on"
    try:
        subprocess.run(["nmcli", "radio", "wifi", action], check=True)
    except Exception:
        pass


def toggle_bluetooth():
    st = get_status()
    action = "off" if st["bt_enabled"] else "on"
    try:
        subprocess.run(["bluetoothctl", "power", action], check=True)
    except Exception:
        pass


def toggle_nightlight():
    try:
        subprocess.run(["omarchy-toggle-nightlight"], check=True)
    except Exception:
        pass


def toggle_bar():
    try:
        subprocess.run(["omarchy-toggle", "bar"], check=True)
    except Exception:
        pass


def main():
    if len(sys.argv) < 2:
        notify_gui("toggle")
        return

    cmd = sys.argv[1].lower()

    if cmd in ("toggle", "gui"):
        notify_gui("toggle")
    elif cmd == "open":
        notify_gui("open")
    elif cmd in ("wifi", "open-wifi", "wifi-gui"):
        notify_gui("open_wifi")
    elif cmd in ("bt", "open-bt", "bt-gui"):
        notify_gui("open_bt")
    elif cmd == "close":
        notify_gui("close")
    elif cmd == "status":
        print(json.dumps(get_status(), indent=2))
    elif cmd in ("wifi-scan", "scan-wifi"):
        print(json.dumps(scan_wifi(), indent=2))
    elif cmd in ("wifi-connect", "connect-wifi") and len(sys.argv) >= 3:
        ssid = sys.argv[2]
        pwd = sys.argv[3] if len(sys.argv) >= 4 else None
        ok = connect_wifi(ssid, pwd)
        print(json.dumps({"success": ok, "ssid": ssid}))
        notify_gui("refresh")
    elif cmd in ("bt-scan", "scan-bt"):
        print(json.dumps(scan_bt(), indent=2))
    elif cmd in ("bt-connect", "connect-bt") and len(sys.argv) >= 3:
        mac = sys.argv[2]
        ok = connect_bt(mac)
        print(json.dumps({"success": ok, "mac": mac}))
        notify_gui("refresh")
    elif cmd in ("bt-disconnect", "disconnect-bt") and len(sys.argv) >= 3:
        mac = sys.argv[2]
        ok = disconnect_bt(mac)
        print(json.dumps({"success": ok, "mac": mac}))
        notify_gui("refresh")
    elif cmd == "set-vol" and len(sys.argv) >= 3:
        set_volume(int(sys.argv[2]))
        notify_gui("refresh")
    elif cmd == "toggle-mute":
        toggle_mute()
        notify_gui("refresh")
    elif cmd == "set-brightness" and len(sys.argv) >= 3:
        set_brightness(int(sys.argv[2]))
        notify_gui("refresh")
    elif cmd == "toggle-wifi":
        toggle_wifi()
        notify_gui("refresh")
    elif cmd == "toggle-bt":
        toggle_bluetooth()
        notify_gui("refresh")
    elif cmd == "toggle-nightlight":
        toggle_nightlight()
        notify_gui("refresh")
    elif cmd == "toggle-bar":
        toggle_bar()
        notify_gui("refresh")
    else:
        print(f"Unknown command: {cmd}")
        print("Usage: milo-control-center [toggle|open|close|status|wifi-scan|wifi-connect <ssid> [pwd]|bt-scan|bt-connect <mac>|set-vol <pct>|set-brightness <pct>|toggle-wifi|toggle-bt|toggle-nightlight|toggle-bar]")


if __name__ == "__main__":
    main()
