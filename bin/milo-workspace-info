#!/usr/bin/env bash
set -euo pipefail
# Milo Workspace Info Utility
# Prints active Hyprland workspace, window count, and focused title with colorized output.

# Handle help flag
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: milo-workspace-info [OPTIONS]"
    echo ""
    echo "Prints current Hyprland workspace, window count, and focused title."
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this help message and exit."
    exit 0
fi

# Colors
CYAN='\033[0;36m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if Hyprland is running
if ! pgrep -x "Hyprland" > /dev/null; then
    echo -e "${RED}Error: Hyprland is not running.${NC}"
    exit 1
fi

# Get active workspace
active_ws=$(hyprctl -j activeworkspace | jq -r '.id')
active_ws_name=$(hyprctl -j activeworkspace | jq -r '.name')

# Get window count on active workspace
window_count=$(hyprctl -j clients | jq -r --arg ws "$active_ws" '[.[] | select(.workspace.id == ($ws|tonumber))] | length')

# Get focused window title
focused_title=$(hyprctl -j activewindow | jq -r '.title')

# Fallback if no window is focused
if [[ -z "$focused_title" || "$focused_title" == "null" ]]; then
    focused_title="No Window Focused"
fi

# Output
echo -e "${CYAN}Milo Workspace Info${NC}"
echo -e "${YELLOW}Workspace:${NC} ${GREEN}${active_ws_name}${NC} (ID: ${active_ws})"
echo -e "${YELLOW}Windows:${NC}   ${GREEN}${window_count}${NC}"
echo -e "${YELLOW}Focus:${NC}     ${RED}${focused_title}${NC}"

exit 0
