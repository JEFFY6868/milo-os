#!/usr/bin/env bash
# ==============================================================================
# milo-drop - Universal P2P AirDrop & Local Network File Sharing
# Launches PyQt6 Cyberpunk GUI by default or handles CLI send/receive.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -d "$SCRIPT_DIR/drop" ]; then
    DROP_DIR="$SCRIPT_DIR/drop"
elif [ -d "/home/jeffy/Projects/milo-os/drop" ]; then
    DROP_DIR="/home/jeffy/Projects/milo-os/drop"
elif [ -d "$HOME/.local/share/milo-drop" ]; then
    DROP_DIR="$HOME/.local/share/milo-drop"
else
    DROP_DIR="/home/jeffy/Projects/milo-os/drop"
fi

CLI_BIN=""
if [ -x "$SCRIPT_DIR/bin/milo-drop-cli" ]; then
    CLI_BIN="$SCRIPT_DIR/bin/milo-drop-cli"
elif [ -x "$HOME/.local/bin/milo-drop-cli" ]; then
    CLI_BIN="$HOME/.local/bin/milo-drop-cli"
elif [ -x "/home/jeffy/Projects/milo-os/bin/milo-drop-cli" ]; then
    CLI_BIN="/home/jeffy/Projects/milo-os/bin/milo-drop-cli"
fi

case "$1" in
    gui|--gui)
        exec python3 "$DROP_DIR/gui.py" "${@:2}"
        ;;
    server|daemon|--server)
        exec python3 "$DROP_DIR/server.py" "${@:2}"
        ;;
    send)
        if [ -n "$2" ] && [ -n "$3" ]; then
            if [ -n "$CLI_BIN" ]; then
                exec "$CLI_BIN" send "$2" "$3"
            else
                python3 -c "
import sys; sys.path.insert(0, '$DROP_DIR')
from gui import SenderThread
from PyQt6.QtCore import QCoreApplication
app = QCoreApplication(sys.argv)
s = SenderThread(sys.argv[1], sys.argv[2])
s.progress_signal.connect(lambda p, m: print(f'[{p}%] {m}'))
s.finished_signal.connect(lambda ok, m: (print(m), app.quit()))
s.start()
app.exec()
" "$2" "$3"
            fi
        else
            echo "Usage: milo-drop send <filepath> <receiver_ip>"
            exit 1
        fi
        ;;
    recv|receive)
        if [ "$2" == "--cli" ] || [ -z "$WAYLAND_DISPLAY" -a -z "$DISPLAY" ]; then
            if [ -n "$CLI_BIN" ]; then
                exec "$CLI_BIN" recv
            else
                exec python3 "$DROP_DIR/server.py"
            fi
        else
            exec python3 "$DROP_DIR/gui.py"
        fi
        ;;
    cli)
        if [ -n "$CLI_BIN" ]; then
            exec "$CLI_BIN" "${@:2}"
        else
            echo "milo-drop-cli not found"
            exit 1
        fi
        ;;
    help|--help|-h)
        echo "================================================================================"
        echo " 🌐 MILO DROP // AirDrop & Local Network File Sharing"
        echo "================================================================================"
        echo "  milo-drop              Launch native cyberpunk desktop UI"
        echo "  milo-drop gui          Launch native cyberpunk desktop UI"
        echo "  milo-drop server       Run background web server on port 4242"
        echo "  milo-drop send <f> <i> Send file to local peer IP"
        echo "  milo-drop recv         Start receiving files"
        echo "================================================================================"
        exit 0
        ;;
    *)
        exec python3 "$DROP_DIR/gui.py" "$@"
        ;;
esac
