#!/usr/bin/env bash
# milo-brightness: Adjusts brightness (10-100%) and displays ASCII bar
# Author: Milo
# Target: Arch Linux / Hyprland

set -euo pipefail

usage() {
    echo "Usage: milo-brightness [-h|--help] [percentage]"
    echo ""
    echo "Adjusts screen brightness between 10% and 100% and displays an ASCII bar."
    echo ""
    echo "Options:"
    echo "  -h, --help      Show this help message and exit."
    echo "  <percentage>    Target brightness (10-100). If omitted, only displays current status."
    exit 0
}

# Handle Help Flag
if [[ "$#" -gt 0 && ("$1" == "-h" || "$1" == "--help") ]]; then
    usage
fi

if [[ "$#" -gt 0 ]]; then
    TARGET_PCT="$1"
    # Strip any trailing %
    TARGET_PCT="${TARGET_PCT%\%}"
    
    # Validate Input
    if ! [[ "$TARGET_PCT" =~ ^[0-9]+$ ]]; then
        echo "Error: Brightness must be a number." >&2
        exit 1
    fi

    # Clamp to 10-100
    if [[ "$TARGET_PCT" -lt 10 ]]; then
        TARGET_PCT=10
    elif [[ "$TARGET_PCT" -gt 100 ]]; then
        TARGET_PCT=100
    fi

    if command -v brightnessctl >/dev/null 2>&1; then
        brightnessctl set "${TARGET_PCT}%" -q >/dev/null 2>&1 || true
    fi
fi

# Fetch current brightness percentage
CURRENT_PCT=50
if command -v brightnessctl >/dev/null 2>&1; then
    INFO=$(brightnessctl -m || true)
    CURRENT_PCT=$(echo "$INFO" | cut -d',' -f4 | tr -d '%' || echo "50")
fi

# Generate ASCII Bar (20 characters)
BAR_WIDTH=20
FILLED_CHARS=$(( (CURRENT_PCT * BAR_WIDTH) / 100 ))
EMPTY_CHARS=$(( BAR_WIDTH - FILLED_CHARS ))

BAR=""
for ((i=0; i<FILLED_CHARS; i++)); do BAR+="="; done
for ((i=0; i<EMPTY_CHARS; i++)); do BAR+="-"; done

echo "[milo-brightness] [${BAR}] ${CURRENT_PCT}%"
