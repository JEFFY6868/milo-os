#!/usr/bin/env bash
# ==============================================================================
# Milo Sovereign WhatsApp Gateway & Communication Suite
# Part of MiloOS. Built for Arch Linux, Hyprland & Tactical Trinity HUD.
# Local Baileys engine with zero cloud analytics, AI inbox summaries & HUD caching.
# ==============================================================================
set -eo pipefail

# Resolve symlinks so REPO_DIR points to the actual milo-os root
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [ ! -d "${REPO_DIR}/core" ] && [ -d "${HOME}/Projects/milo-os/core" ]; then
  REPO_DIR="${HOME}/Projects/milo-os"
fi

OPENWA_DIR="${HOME}/.local/share/milo/openwa"
API_KEY_FILE="${OPENWA_DIR}/data/.api-key"
QR_IMAGE="${HOME}/.local/share/milo/whatsapp_qr.png"
BRIDGE_SCRIPT="${HOME}/.local/share/milo/wa_bridge.py"
OPENWA_URL="http://127.0.0.1:2785"
WEBHOOK_URL="http://127.0.0.1:2786/webhook"

# Terminal Colors
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
MAGENTA="\033[35m"
BOLD="\033[1m"
DIM="\033[2m"
RESET="\033[0m"

get_api_key() {
  if [[ -f "$API_KEY_FILE" ]]; then
    cat "$API_KEY_FILE" | tr -d '\n\r'
  else
    echo ""
  fi
}

get_session_id() {
  local key
  key=$(get_api_key)
  curl -s -H "X-API-Key: ${key}" "${OPENWA_URL}/api/sessions" | jq -r '.[0].id // empty' 2>/dev/null || true
}

ensure_service_running() {
  if ! systemctl --user is-active --quiet milo-openwa.service; then
    echo -e "${YELLOW}Starting milo-openwa service...${RESET}"
    systemctl --user start milo-openwa.service
    sleep 3
  fi
}

CMD="${1:-}"

case "$CMD" in
  status)
    echo -e "\n${BOLD}${CYAN}📱 MILO WHATSAPP GATEWAY (OpenWA Baileys)${RESET}"
    SVC_STATUS=$(systemctl --user is-active milo-openwa.service 2>/dev/null || echo "inactive")
    if [[ "$SVC_STATUS" == "active" ]]; then
      echo -e "  ${BOLD}Gateway Service:${RESET} ${GREEN}● Active (Running on port 2785)${RESET}"
    else
      echo -e "  ${BOLD}Gateway Service:${RESET} ${RED}○ Inactive${RESET}"
    fi

    BRIDGE_STATUS=$(systemctl --user is-active milo-wa-bridge.service 2>/dev/null || echo "inactive")
    if [[ "$BRIDGE_STATUS" == "active" ]]; then
      echo -e "  ${BOLD}AI Bridge Daemon:${RESET} ${GREEN}● Active (Listening for phone messages)${RESET}"
    else
      echo -e "  ${BOLD}AI Bridge Daemon:${RESET} ${YELLOW}○ Stopped (Run: systemctl --user start milo-wa-bridge)${RESET}"
    fi

    KEY=$(get_api_key)
    if [[ -z "$KEY" ]]; then
      echo -e "  ${BOLD}API Key:${RESET} ${YELLOW}Not yet generated${RESET}"
      exit 0
    fi
    echo -e "  ${BOLD}API Key:${RESET} ${KEY:0:10}...${KEY: -6}"
    echo -e "  ${BOLD}Dashboard:${RESET} ${CYAN}${OPENWA_URL}${RESET}"

    SESSIONS=$(curl -s -H "X-API-Key: ${KEY}" "${OPENWA_URL}/api/sessions" 2>/dev/null || echo "[]")
    SESSION_COUNT=$(echo "$SESSIONS" | jq '. | length' 2>/dev/null || echo "0")
    echo -e "  ${BOLD}Active Sessions:${RESET} ${SESSION_COUNT}"

    if [[ "$SESSION_COUNT" -gt 0 ]]; then
      echo "$SESSIONS" | jq -r '.[] | "    • ID: \(.id)\n      Name: \(.name)\n      Status: \(.status)\n      Phone: \(.phone // "Not paired")\n      User: \(.pushName // "None")"'
    fi
    echo ""
    ;;

  sync)
    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import sync_inbox
data = sync_inbox()
print(f'${GREEN}✔ WhatsApp Synced:${RESET} {len(data[\"chats\"])} active threads, {data[\"unread_count\"]} unread messages.')
"
    ;;

  list|ls|inbox)
    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import get_inbox_data, format_terminal_list
inbox = get_inbox_data(force_sync=True)
print(format_terminal_list(inbox, unread_only=False))
"
    ;;

  unread)
    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import get_inbox_data, format_terminal_list
inbox = get_inbox_data(force_sync=True)
print(format_terminal_list(inbox, unread_only=True))
"
    ;;

  read)
    shift
    TARGET="${1:-}"
    if [[ -z "$TARGET" ]]; then
      echo "Usage: milo wa read <index_number_or_contact_name>" >&2
      exit 1
    fi
    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import read_chat
print(read_chat('${TARGET}', limit=20))
"
    ;;

  summary|summarize)
    echo -e "${CYAN}✦ Analyzing incoming WhatsApp messages with Milo AI...${RESET}"
    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import summarize_inbox
print(summarize_inbox())
"
    ;;

  send)
    shift
    RECIPIENT="${1:-}"
    shift || true
    MESSAGE="$*"

    if [[ -z "$RECIPIENT" || -z "$MESSAGE" ]]; then
      echo "Usage: milo wa send <contact_or_number> \"<message>\"" >&2
      echo "Example: milo wa send \"Vaishnavi\" \"Hello from Milo!\"" >&2
      echo "Example: milo wa send 919876543210 \"Hello from Milo!\"" >&2
      exit 1
    fi

    python3 -c "
import sys
sys.path.insert(0, '${REPO_DIR}')
from core.whatsapp.engine import send_whatsapp_message
ok, res = send_whatsapp_message('${RECIPIENT}', '''${MESSAGE}''')
if ok:
    print(f'${GREEN}✔ Message Sent Successfully!${RESET} ID: {res}')
else:
    print(f'${RED}✖ Failed to send:${RESET} {res}')
    sys.exit(1)
"
    ;;

  notify)
    shift
    MESSAGE="$*"
    if [[ -z "$MESSAGE" ]]; then
      echo "Usage: milo wa notify \"<message>\"" >&2
      exit 1
    fi
    "$0" send "919087876030@c.us" "$MESSAGE"
    ;;

  qr|pair)
    ensure_service_running
    KEY=$(get_api_key)
    SID=$(get_session_id)

    if [[ -z "$SID" ]]; then
      echo -e "${YELLOW}Creating default session 'milo'...${RESET}"
      SID=$(curl -s -X POST "${OPENWA_URL}/api/sessions" \
        -H "Content-Type: application/json" \
        -H "X-API-Key: ${KEY}" \
        -d '{"name": "milo"}' | jq -r '.id')
      sleep 1
    fi

    echo -e "${CYAN}✦ Starting session ${SID}...${RESET}"
    curl -s -X POST "${OPENWA_URL}/api/sessions/${SID}/start" \
      -H "X-API-Key: ${KEY}" >/dev/null 2>&1 || true

    echo -e "${CYAN}✦ Fetching Pairing QR Code...${RESET}"
    sleep 2

    python3 -c "
import urllib.request, json, base64, os
api_key = '$(get_api_key)'
sid = '${SID}'
req = urllib.request.Request(f'${OPENWA_URL}/api/sessions/{sid}/qr', headers={'X-API-Key': api_key})
try:
    with urllib.request.urlopen(req, timeout=5) as resp:
        d = json.loads(resp.read().decode())
        qr = d.get('qrCode')
        if qr and ',' in qr:
            raw = base64.b64decode(qr.split(',')[1])
            with open('${QR_IMAGE}', 'wb') as f:
                f.write(raw)
            print('QR_SAVED')
        else:
            print(f'STATUS: {d.get(\"status\")}')
except Exception as e:
    print('ERROR:', e)
" > /tmp/milo_qr_res.txt

    RES=$(cat /tmp/milo_qr_res.txt)
    if [[ "$RES" == *"QR_SAVED"* ]]; then
      echo -e "\n${BOLD}${GREEN}✦ SCAN WITH WHATSAPP LINKED DEVICES:${RESET}\n"
      RAW_STRING=$(zbarimg -q --raw "$QR_IMAGE" 2>/dev/null || true)
      if [[ -n "$RAW_STRING" ]] && command -v qrencode >/dev/null; then
        qrencode -t UTF8 "$RAW_STRING"
      fi
      echo -e "\n${DIM}QR Image saved to:${RESET} ${CYAN}${QR_IMAGE}${RESET}"
      echo -e "${DIM}Or open Dashboard in browser:${RESET} ${BOLD}${OPENWA_URL}${RESET}\n"

      if command -v imv >/dev/null && [[ -n "$WAYLAND_DISPLAY" || -n "$DISPLAY" ]]; then
        imv "$QR_IMAGE" >/dev/null 2>&1 &
      fi
    else
      echo -e "${YELLOW}Notice:${RESET} ${RES}"
      echo -e "You can also view the QR live on the Web Dashboard: ${CYAN}${OPENWA_URL}${RESET}"
    fi
    ;;

  dashboard|web)
    echo -e "${CYAN}✦ Opening OpenWA Dashboard (${OPENWA_URL})...${RESET}"
    xdg-open "${OPENWA_URL}" 2>/dev/null || true
    ;;

  start)
    systemctl --user start milo-openwa.service
    echo -e "${GREEN}✦ Started milo-openwa.service${RESET}"
    ;;

  stop)
    systemctl --user stop milo-openwa.service
    echo -e "${YELLOW}✦ Stopped milo-openwa.service${RESET}"
    ;;

  restart)
    systemctl --user restart milo-openwa.service
    echo -e "${GREEN}✦ Restarted milo-openwa.service${RESET}"
    ;;

  prune)
    echo -e "${CYAN}✦ Pruning heavy media blobs and vacuuming openwa.sqlite...${RESET}"
    python3 -c '
import sqlite3, os, json
db_path = "${HOME}/.local/share/milo/openwa/data/openwa.sqlite"
if not os.path.exists(db_path):
    print("Database not found.")
    exit(0)
size_before = os.path.getsize(db_path) / 1024 / 1024
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute("SELECT id, metadata FROM messages WHERE length(metadata) > 1000")
rows = cur.fetchall()
updated = 0
for msg_id, meta_str in rows:
    try:
        data = json.loads(meta_str)
        if "media" in data:
            del data["media"]
            data["media_pruned"] = True
            cur.execute("UPDATE messages SET metadata=? WHERE id=?", (json.dumps(data), msg_id))
            updated += 1
    except Exception:
        pass
conn.commit()
cur.execute("VACUUM")
conn.close()
size_after = os.path.getsize(db_path) / 1024 / 1024
print(f"✔ Done. Size: {size_before:.2f} MB -> {size_after:.2f} MB (Saved {size_before - size_after:.2f} MB)")
'
    ;;

  bridge|listen)
    ensure_service_running
    KEY=$(get_api_key)
    SID=$(get_session_id)

    # Register webhook if not already registered
    echo -e "${CYAN}✦ Registering OpenWA Webhook -> ${WEBHOOK_URL}...${RESET}"
    curl -s -X POST "${OPENWA_URL}/api/sessions/${SID}/webhooks" \
      -H "Content-Type: application/json" \
      -H "X-API-Key: ${KEY}" \
      -d "{\"url\": \"${WEBHOOK_URL}\", \"events\": [\"message.received\"]}" >/dev/null 2>&1 || true

    # Run the Python bridge
    exec python3 "$BRIDGE_SCRIPT"
    ;;

  *)
    cat <<EOF
${BOLD}${CYAN}Milo WhatsApp Sovereign Suite (Powered by OpenWA Baileys)${RESET}

Usage:
  milo wa list           Display recent active WhatsApp threads & unread counts
  milo wa unread         Display only unread WhatsApp threads
  milo wa read <num|id>  Read message history for a specific thread
  milo wa summarize      AI executive briefing of recent messages (Groq / NVIDIA)
  milo wa send <to> <msg> Send WhatsApp message to contact name or phone
  milo wa sync           Sync active chats & messages to HUD cache
  milo wa status         Inspect OpenWA gateway status & session health
  milo wa qr             Display pairing QR code in terminal & save PNG
  milo wa dashboard      Open OpenWA web management UI in browser (port 2785)
  milo wa bridge         Start bidirectional webhook listener (phone <-> Milo brain)
  milo wa start|stop|restart Control background gateway service

EOF
    ;;
esac
